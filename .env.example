# ==============================================================================
# SOSTEntrance Authentication Configuration
# ==============================================================================

# 1. Authentication Cookie (obtained from Chrome DevTools: F12 -> Application -> Cookies)
# For Midas College / University portals, the session cookie is 'ci_session'
COOKIE_NAME="ci_session"
ci_session="PASTE_YOUR_CI_SESSION_COOKIE_VALUE_HERE"

# 2. Courtesy delay between requests in seconds (avoids rate limiting or server overload)
REQUEST_DELAY="0.4"

# 3. Network timeout per request in seconds
REQUEST_TIMEOUT="20.0"
